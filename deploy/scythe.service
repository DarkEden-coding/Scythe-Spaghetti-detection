# Scythe print-failure detection. install.sh fills in @USER@ and @DIR@ and
# installs this as /etc/systemd/system/scythe.service.
#
# Runs as your normal user, never root. The web setup's system changes
# (Tailscale, the Mainsail link) go through /usr/local/lib/scythe/scythe-helper,
# the one command that user may run with sudo; that's why this unit has no
# NoNewPrivileges/ProtectSystem hardening.

[Unit]
Description=Scythe 3D printer failure detection
After=network-online.target moonraker.service
Wants=network-online.target
# Updates and the dashboard's restart button replace the process via execv;
# give that room without systemd deciding the unit is flapping.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/.venv/bin/python -m src run

# Settings can also come from the environment, e.g.:
# Environment=SCYTHE_DISCORD_BOT_TOKEN=...
# EnvironmentFile=-/etc/scythe.env

Restart=always
RestartSec=10

# Inference is CPU-hungry; stay out of the way of Klipper's timing.
Nice=10
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
