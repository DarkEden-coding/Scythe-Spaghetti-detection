#!/usr/bin/env bash
# Root helper for Scythe's web setup.
#
# install.sh copies this to /usr/local/lib/scythe/scythe-helper (owned by root,
# not writable by the Scythe user) and adds a sudoers rule that lets the Scythe
# user run only this file. Every action is fixed; the only argument accepted is
# a port number, which is validated.
set -euo pipefail

NGINX_SITES=(/etc/nginx/sites-available/mainsail /etc/nginx/sites-available/fluidd)
BEGIN_MARK="# scythe-begin (added by Scythe's setup; remove this block to unlink)"
END_MARK="# scythe-end"

die() { echo "$*" >&2; exit 1; }

port_arg() {
    [[ "${1:-}" =~ ^[0-9]{2,5}$ ]] && (( $1 >= 80 && $1 <= 65535 )) || die "Invalid port: ${1:-}"
    echo "$1"
}

nginx_site() {
    for site in "${NGINX_SITES[@]}"; do
        [[ -f "$site" ]] && { echo "$site"; return; }
    done
    die "No Mainsail or Fluidd nginx site found."
}

nginx_apply() {
    # $1 = site file, $2 = backup to restore if the new config is rejected.
    if ! nginx -t >/dev/null 2>&1; then
        cp "$2" "$1"
        die "nginx rejected the change; the previous config was restored."
    fi
    systemctl reload nginx
}

case "${1:-}" in
    tailscale-install)
        command -v tailscale >/dev/null && { echo "Tailscale is already installed."; exit 0; }
        curl -fsSL https://tailscale.com/install.sh | sh
        ;;
    tailscale-up)
        command -v tailscale >/dev/null || die "Tailscale is not installed."
        # `tailscale up` blocks until the login finishes, so run it in the
        # background; the dashboard reads the login URL from `tailscale status`.
        setsid tailscale up >/var/log/scythe-tailscale-up.log 2>&1 < /dev/null &
        for _ in $(seq 20); do
            sleep 1
            tailscale status --json 2>/dev/null | grep -q '"AuthURL": *"http' && exit 0
            tailscale status >/dev/null 2>&1 && exit 0
        done
        ;;
    tailscale-serve)
        port=$(port_arg "${2:-}")
        tailscale serve --bg --https=443 "http://127.0.0.1:$port"
        ;;
    tailscale-serve-off)
        tailscale serve --https=443 off
        ;;
    mainsail-link)
        port=$(port_arg "${2:-}")
        site=$(nginx_site)
        backup="$site.bak-scythe"
        cp "$site" "$backup"
        sed -i "/$BEGIN_MARK/,/$END_MARK/d" "$site"
        if grep -q "location /scythe/" "$site"; then
            echo "A /scythe/ location already exists in $site; leaving it as is."
            exit 0
        fi
        # Insert the block before the first `location` in the server block.
        awk -v port="$port" -v begin="$BEGIN_MARK" -v end="$END_MARK" '
            !done && /^[ \t]*location / {
                print "    " begin
                print "    location /scythe/ {"
                print "        proxy_pass http://127.0.0.1:" port "/;"
                print "        proxy_buffering off;"
                print "    }"
                print "    " end
                print ""
                done = 1
            }
            { print }' "$site" > "$site.new"
        grep -q "location /scythe/" "$site.new" || { rm -f "$site.new"; die "Could not find where to add the link in $site."; }
        cat "$site.new" > "$site" && rm -f "$site.new"
        nginx_apply "$site" "$backup"
        ;;
    mainsail-unlink)
        site=$(nginx_site)
        backup="$site.bak-scythe"
        cp "$site" "$backup"
        sed -i "/$BEGIN_MARK/,/$END_MARK/d" "$site"
        nginx_apply "$site" "$backup"
        ;;
    *)
        die "Usage: scythe-helper {tailscale-install|tailscale-up|tailscale-serve PORT|tailscale-serve-off|mainsail-link PORT|mainsail-unlink}"
        ;;
esac
